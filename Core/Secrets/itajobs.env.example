# Credenciais do banco. Preencha antes de subir a API.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Origem do frontend liberada no CORS (varias separadas por virgula).
FRONTEND_URL=http://localhost:8080

# Assinatura dos tokens JWT: texto aleatorio de 32+ caracteres. Gere um com
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do token em horas.
JWT_EXPIRA_HORAS=8

# Fuso da sessao do banco (horario das datas gravadas).
DB_TIMEZONE=America/Sao_Paulo

# Tentativas de login por IP a cada minuto; passou disso, 429.
LOGIN_TENTATIVAS_POR_MINUTO=5

# Pool de conexoes com o banco. DB_POOL_MAX fica abaixo do max_connections do
# Postgres (100 por padrao). Com o pool cheio, a request espera ate
# DB_POOL_ESPERA_SEGUNDOS por uma conexao livre.
DB_POOL_MAX=80
DB_POOL_MIN=10
DB_POOL_ESPERA_SEGUNDOS=30
